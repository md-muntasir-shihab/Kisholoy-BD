{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/server.bundle.cjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/server.bundle.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:local": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist api/server.bundle.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test KISHOLOY_TESTS=1 KISHOLOY_PERSISTENCE_DRIVER=file tsx --test tests/*.test.ts",
    "test:security": "NODE_ENV=test KISHOLOY_TESTS=1 KISHOLOY_PERSISTENCE_DRIVER=file tsx --test tests/security.test.ts",
    "test:api": "NODE_ENV=test KISHOLOY_TESTS=1 KISHOLOY_PERSISTENCE_DRIVER=file tsx --test tests/api-surface.test.ts",
    "test:bundle": "NODE_ENV=test KISHOLOY_TESTS=1 tsx --test tests/serverless-bundle.test.ts",
    "seed": "KISHOLOY_PERSISTENCE_DRIVER=file tsx scripts/seed-cli.ts",
    "seed:demo": "tsx scripts/seed-cli.ts --force",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "autoprefixer": "^10.4.21",
    "bwip-js": "^4.11.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
